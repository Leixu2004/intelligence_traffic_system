POSTGRES_DB=traffic
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
PREDICTION_API_KEY=
APP_ENV=development
API_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# 仅本地排障时可设为 true；默认 500 响应不返回内部异常细节。
API_EXPOSE_INTERNAL_ERRORS=false
# 中国收费站 LSTM 研究候选；正式商用前仍需用项目现场授权数据重新训练。
TRAFFIC_MODEL_PATH=/app/backend/prediction/models/traffic_lstm_china_kdd2017_candidate_v1.onnx
TRAFFIC_RECORDS_PATH=/app/data/china_lstm_demo_records.csv
KAFKA_TOPIC_TRAFFIC=traffic_stream
KAFKA_TOPIC_PLATES=plate_recognitions
KAFKA_TOPIC_VIOLATIONS=traffic_violations
KAFKA_AUTO_OFFSET_RESET=earliest
AMAP_KEY=
AMAP_SECURITY_CODE=

# 交通指挥 Agent。未启用或未配置密钥时，预测 API 与大屏仍可独立运行。
TRAFFIC_AGENT_ENABLED=false
TRAFFIC_AGENT_PROVIDER=aliyun-bailian
TRAFFIC_AGENT_MODEL=deepseek-v4-flash-0731
TRAFFIC_AGENT_API_KEY=
# 百炼官方环境变量；与 TRAFFIC_AGENT_API_KEY 二选一，前者优先。
DASHSCOPE_API_KEY=
# 快速联调使用共享地址；生产环境建议替换为业务空间专属 base URL。
TRAFFIC_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TRAFFIC_AGENT_TEMPERATURE=0.1
TRAFFIC_AGENT_TIMEOUT_SECONDS=30
TRAFFIC_AGENT_MAX_RETRIES=2
TRAFFIC_AGENT_MAX_ITERATIONS=6
TRAFFIC_AGENT_AUDIT_PATH=/app/data/agent/agent_runs.jsonl

# 法规 RAG 知识库（PROJECT_SPEC.md）。未启用时预测 API 与 Agent 仍可独立运行；
# 启用后 Agent 自动获得 search_traffic_law 只读工具。
TRAFFIC_RAG_ENABLED=false
# bge-local（需 pip install sentence-transformers 并下载模型）| openai-compatible | hashing-test（仅测试）
TRAFFIC_RAG_EMBEDDING_PROVIDER=openai-compatible
TRAFFIC_RAG_EMBEDDING_MODEL=text-embedding-v4
TRAFFIC_RAG_EMBEDDING_DIM=1024
TRAFFIC_RAG_EMBEDDING_DEVICE=cpu
# auto = Milvus Lite 优先、FAISS 兜底；也可固定 milvus-lite 或 faiss
TRAFFIC_RAG_VECTOR_BACKEND=auto
TRAFFIC_RAG_MILVUS_URI=/app/data/rag/traffic_law.db
TRAFFIC_RAG_COLLECTION=traffic_law
TRAFFIC_RAG_DOCS_DIR=/app/data/rag/laws
TRAFFIC_RAG_REGISTRY_PATH=/app/data/rag/law_documents.json
TRAFFIC_RAG_AUDIT_PATH=/app/data/rag/rag_runs.jsonl
TRAFFIC_RAG_TOP_K=3
TRAFFIC_RAG_MIN_SCORE=0.3
TRAFFIC_RAG_CHUNK_SIZE=500
TRAFFIC_RAG_CHUNK_OVERLAP=50
# RAG 问答 LLM 默认复用 TRAFFIC_AGENT_* / DASHSCOPE_API_KEY，可按需覆盖：
TRAFFIC_RAG_LLM_MODEL=
TRAFFIC_RAG_LLM_BASE_URL=
TRAFFIC_RAG_LLM_API_KEY=
TRAFFIC_RAG_TEMPERATURE=0.1

# 多 Agent 应急处置（CrewAI，课件《20260917》）。默认关闭；未启用或未配置密钥时，
# 预测 API、Agent 与 RAG 仍可独立运行。密钥只从环境变量读取，不要写进 backend/crew/config.yaml。
TRAFFIC_CREW_ENABLED=false
# aliyun-bailian / bailian / dashscope 时自动套用百炼兼容模式 base_url 与默认模型。
TRAFFIC_CREW_PROVIDER=aliyun-bailian
# hierarchical（Manager 动态派活，课件验收要求）| sequential（固定顺序，课堂演示更快）
TRAFFIC_CREW_PROCESS=hierarchical
TRAFFIC_CREW_LLM_MODEL=deepseek-v4-flash-0731
# 留空则依次回落 TRAFFIC_AGENT_API_KEY → DASHSCOPE_API_KEY（仅百炼）→ OPENAI_API_KEY
TRAFFIC_CREW_LLM_API_KEY=
TRAFFIC_CREW_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# manager LLM 留空则复用 TRAFFIC_CREW_LLM_MODEL。
TRAFFIC_CREW_MANAGER_MODEL=
TRAFFIC_CREW_TEMPERATURE=0.3
TRAFFIC_CREW_TIMEOUT_SECONDS=60
TRAFFIC_CREW_MAX_RETRIES=1
TRAFFIC_CREW_MAX_ITER=6
# 协作过程日志 / CrewAI 记忆，默认关闭。
TRAFFIC_CREW_VERBOSE=false
TRAFFIC_CREW_MEMORY=false
# auto：有 AMAP_KEY 走真实路网，否则回落到 config.yaml 的演示走廊；static 强制离线；amap 强制真实。
TRAFFIC_CREW_ROUTE_MODE=auto
# 高德路径规划超时（秒），配合上面的 AMAP_KEY 使用。
TRAFFIC_CREW_AMAP_TIMEOUT_SECONDS=8
# 以下三项留空即用内置默认（backend/crew/config.yaml、data/crew/crew_runs.jsonl、data/crew/public_notices.jsonl）；
# 若需显式覆盖，请填写运行环境内的路径，Docker 容器内为 /app/...。
# TRAFFIC_CREW_CONFIG_PATH=
# TRAFFIC_CREW_AUDIT_PATH=
# TRAFFIC_CREW_NOTIFY_PATH=

# 主机上运行 main.py 时使用以下配置。
KAFKA_BROKER=localhost:9092
CAMERA_ID=CAM-01
CHECKPOINT_ID=CP-NORTH-01
CHECKPOINT_GPS_LNG=116.4074
CHECKPOINT_GPS_LAT=39.9042
VIDEO_SOURCE=D:\test_vedio\traffic.mp4
RECOGNITION_MODE=violation_only

# 离线 OCR 可将 PaddleOCR 检测/识别模型放入项目目录后配置这两个路径。
PADDLE_PDX_CACHE_HOME=D:\intelligent_transportation\intel-transportation\data\paddlex_cache
PADDLE_TEXT_DETECTION_MODEL_DIR=
PADDLE_TEXT_RECOGNITION_MODEL_DIR=
